{
  "name": "@openzeppelin/codegen-rwa-stellar",
  "private": false,
  "version": "0.0.0",
  "description": "Stellar/Soroban RWA token project generator. Produces complete multi-contract Rust projects from declarative configuration.",
  "keywords": [
    "openzeppelin",
    "stellar",
    "soroban",
    "rwa",
    "codegen",
    "rust"
  ],
  "author": "OpenZeppelin",
  "homepage": "https://github.com/OpenZeppelin/rwa-wizard#readme",
  "bugs": {
    "url": "https://github.com/OpenZeppelin/rwa-wizard/issues"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenZeppelin/rwa-wizard.git",
    "directory": "packages/codegen-rwa-stellar"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "[ \"$SKIP_PUBLISH_BUILD\" = \"true\" ] || pnpm build",
    "dev": "tsdown --watch",
    "sync:stellar-templates": "node ./scripts/sync-stellar-templates.mjs",
    "test:manual:e2e": "pnpm build && node ./scripts/manual-e2e.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules/.tmp/tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" --config ../../.prettierrc.cjs",
    "format:check": "prettier --check \"src/**/*.ts\" --config ../../.prettierrc.cjs"
  },
  "dependencies": {
    "@openzeppelin/adapter-stellar": "^2.0.0",
    "@openzeppelin/codegen-core": "workspace:*",
    "@openzeppelin/codegen-rwa-common": "workspace:*",
    "@openzeppelin/rwa-config": "workspace:*",
    "@openzeppelin/ui-types": "^2.0.0",
    "i18n-iso-countries": "^7.14.0"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  }
}

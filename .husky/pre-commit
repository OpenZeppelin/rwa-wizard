#!/usr/bin/env bash

echo "🔍 Running pre-commit checks..."

# Try to use NVM's Node.js if available
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # Load NVM
  export NVM_DIR="$HOME/.nvm"
  \. "$NVM_DIR/nvm.sh" # This loads nvm
  
  # Use Node.js 22+ (|| true because nvm use failing is non-fatal; the check below is the gate)
  nvm use 22 >/dev/null 2>&1 || true
  
  echo "✅ Using Node.js $(node -v) from NVM"
fi

# Require Node.js 22+ as specified in package.json
node_version=$(node -v | cut -d. -f1 | sed 's/v//')
if [ "$node_version" -lt 22 ]; then
  echo "❌ Error: Node.js version $(node -v) is incompatible. This project requires Node.js 22.13.0+."
  echo "❌ Commit aborted. Please use Node.js 22+ for development."
  exit 1
fi

# Check if there are any staged files
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged_files" ]; then
  echo "ℹ️ No files staged for commit, skipping checks."
  exit 0
fi

# Check for local file/tarball dependencies in package.json.
# The local-dev workflow should never require committed `file:` overrides.
if echo "$staged_files" | grep -q "apps/rwa-wizard/package.json"; then
  if grep -q "\"file:" apps/rwa-wizard/package.json; then
    echo ""
    echo "❌ Error: Local file dependencies detected in package.json!"
    echo "   These paths (file:...) will fail in CI/production."
    echo ""
    echo "   👉 Run 'pnpm dev:npm' to switch to registry versions."
    echo ""
    exit 1
  fi
fi

# Run formatting and linting on staged files
echo "🎨 Running formatting and linting..."
pnpm fix-all

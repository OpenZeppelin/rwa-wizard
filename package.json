{
  "name": "rwa-wizard-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "clean": "pnpm -r clean",
    "install-deps": "pnpm install --frozen-lockfile --ignore-scripts --prefer-offline",
    "dev": "pnpm --filter @openzeppelin/rwa-wizard-app dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:app": "pnpm --filter @openzeppelin/rwa-wizard-app build",
    "e2e:testnet": "pnpm --filter @openzeppelin/codegen-rwa-stellar e2e:testnet",
    "test": "node --test .pnpmfile.test.cjs && pnpm -r test",
    "test:all": "pnpm -r --parallel test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "fix-all": "pnpm format && pnpm lint:fix",
    "prepare": "husky",
    "commit": "git-cz",
    "install-pnpm": "npm install -g pnpm@10.22.0",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "dev:uikit:local": "LOCAL_UI_PATH=\"${LOCAL_UI_PATH:-../openzeppelin-ui}\" && LOCAL_UI_PATH=\"$LOCAL_UI_PATH\" oz-ui-dev use local --project \"$PWD\" --family ui",
    "dev:adapters:local": "LOCAL_ADAPTERS_PATH=\"${LOCAL_ADAPTERS_PATH:-../openzeppelin-adapters}\" && LOCAL_ADAPTERS_PATH=\"$LOCAL_ADAPTERS_PATH\" oz-ui-dev use local --project \"$PWD\" --family adapters",
    "dev:local": "LOCAL_UI_PATH=\"${LOCAL_UI_PATH:-../openzeppelin-ui}\" && LOCAL_ADAPTERS_PATH=\"${LOCAL_ADAPTERS_PATH:-../openzeppelin-adapters}\" && LOCAL_UI_PATH=\"$LOCAL_UI_PATH\" LOCAL_ADAPTERS_PATH=\"$LOCAL_ADAPTERS_PATH\" oz-ui-dev use local --project \"$PWD\" --family ui --family adapters",
    "dev:npm": "oz-ui-dev use remote --project \"$PWD\"",
    "docker:dev": "docker-compose up --build",
    "check-licenses": "node scripts/check-dependency-licenses.cjs",
    "check-adapter-peers": "oz-ui-dev check-peers --project \"$PWD\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": "pnpm fix-all"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "4.5.1",
    "@openzeppelin/ui-dev-cli": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.8",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "commitizen": "^4.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.3.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.23",
    "prettier": "3.8.5",
    "prettier-linter-helpers": "^1.0.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "tailwindcss": "^3.4.19",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "@metamask/eth-json-rpc-provider": "^2.2.0",
      "axios": "^1.16.0",
      "protobufjs": "^7.6.3",
      "@protobufjs/utf8": "^1.1.1",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0",
      "hono": "^4.12.25",
      "h3": "^1.15.9",
      "react-router": "^7.15.0",
      "socket.io-parser": "^4.2.6",
      "form-data": "^4.0.6",
      "ua-parser-js@2": "2.0.7",
      "uuid@8": "^11.1.1",
      "uuid@9": "^11.1.1",
      "ip-address": "^10.1.1",
      "bn.js@4": "^4.12.3",
      "rollup": "^4.59.0",
      "esbuild": "^0.28.1",
      "tmp": "^0.2.7",
      "lodash": "^4.18.1",
      "minimatch@3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "js-yaml@4": "^4.2.0",
      "flatted": "^3.4.2",
      "fast-uri": "^3.1.2",
      "defu": "^6.1.5",
      "postcss": "^8.5.10",
      "@babel/core": "^7.29.6",
      "vite": "^7.3.5",
      "vitest": "^3.2.6",
      "happy-dom": "^20.8.9"
    }
  }
}

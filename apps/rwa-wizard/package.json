{
  "name": "@openzeppelin/rwa-wizard-app",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "baseline:step-markup": "vite-node scripts/generate-step-markup-baseline.mjs",
    "supersede:step-markup": "vite-node scripts/supersede-step-markup.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" --config ../../.prettierrc.cjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" --config ../../.prettierrc.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^12.9.0",
    "@openzeppelin/adapter-evm": "^5.0.0",
    "@openzeppelin/adapter-stellar": "^4.0.1",
    "@openzeppelin/codegen-core": "workspace:*",
    "@openzeppelin/codegen-rwa-common": "workspace:*",
    "@openzeppelin/codegen-rwa-stellar": "workspace:*",
    "@openzeppelin/rwa-config": "workspace:*",
    "@openzeppelin/rwa-wizard-copy": "workspace:*",
    "@openzeppelin/ui-components": "^3.9.0",
    "@openzeppelin/ui-react": "^3.3.2",
    "@openzeppelin/ui-renderer": "^3.4.2",
    "@openzeppelin/ui-storage": "^1.2.5",
    "@openzeppelin/ui-styles": "^1.1.1",
    "@openzeppelin/ui-types": "^3.5.2",
    "@openzeppelin/ui-utils": "^4.0.1",
    "@pierre/trees": "1.0.0-beta.6",
    "lucide-react": "^0.555.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7"
  }
}
